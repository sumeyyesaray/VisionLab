       "1  datasets\\extracted\\flower_data\\train\\1\\image_0...        1  pink primrose  \n",
       "2  datasets\\extracted\\flower_data\\train\\1\\image_0...        1  pink primrose  \n",
       "3  datasets\\extracted\\flower_data\\train\\1\\image_0...        1  pink primrose  \n",
       "4  datasets\\extracted\\flower_data\\train\\1\\image_0...        1  pink primrose  "
      ]
