  {
   "cell_type": "code",
   "execution_count": 8,
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-07-05T17:33:43.199493Z",
     "iopub.status.busy": "2026-07-05T17:33:43.199493Z",
     "iopub.status.idle": "2026-07-05T17:33:51.571430Z",
     "shell.execute_reply": "2026-07-05T17:33:51.571430Z"
    },
    "id": "6b1d7b9a"
   },
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 800x500 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
